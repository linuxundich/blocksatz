{
    "id": "de.linuxundich.Blocksatz",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "blocksatz",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--filesystem=host:rw"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/blocksatz/cargo-home",
            "BLOCKSATZ_LOCALEDIR": "/app/share/locale"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0",
        "/share/vala"
    ],
    "modules": [
        {
            "name": "libspelling",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddocs=false",
                "-Dvapi=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/libspelling.git",
                    "tag": "0.4.10"
                }
            ]
        },
        {
            "name": "blocksatz",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 cargo-vendor-config.toml .cargo/config.toml",
                "cargo --offline build --release",
                "install -Dm755 target/release/blocksatz /app/bin/blocksatz",
                "for mo in po/locale/*/LC_MESSAGES/blocksatz.mo; do install -Dm644 \"$mo\" \"/app/share/locale/${mo#po/locale/}\"; done",
                "install -Dm644 data/de.linuxundich.Blocksatz.desktop /app/share/applications/de.linuxundich.Blocksatz.desktop",
                "install -Dm644 data/de.linuxundich.Blocksatz.metainfo.xml /app/share/metainfo/de.linuxundich.Blocksatz.metainfo.xml",
                "for size in 48 64 128 256; do install -Dm644 data/icons/hicolor/${size}x${size}/apps/de.linuxundich.Blocksatz.png /app/share/icons/hicolor/${size}x${size}/apps/de.linuxundich.Blocksatz.png; done",
                "install -Dm644 data/icons/hicolor/scalable/apps/de.linuxundich.Blocksatz.svg /app/share/icons/hicolor/scalable/apps/de.linuxundich.Blocksatz.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/de.linuxundich.Blocksatz-symbolic.svg /app/share/icons/hicolor/symbolic/apps/de.linuxundich.Blocksatz-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        "target",
                        "po/locale",
                        "build-aux/flatpak/.flatpak-builder",
                        "build-aux/flatpak/build-dir",
                        "build-aux/flatpak/repo",
                        "build-aux/flatpak/.cache",
                        ".claude",
                        "blocksatz-quill-features.mbox"
                    ]
                },
                {
                    "type": "dir",
                    "path": ".cache/vendor",
                    "dest": "vendor"
                },
                {
                    "type": "file",
                    "path": ".cache/cargo-vendor-config.toml"
                }
            ]
        }
    ]
}
